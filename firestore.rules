rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isPlatformAdmin() {
      return signedIn() && userProfile().data.roleGlobal == "platform_admin";
    }

    function memberDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isMember(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupAdmin(groupId) {
      return isMember(groupId) && memberDoc(groupId).data.role == "group_admin";
    }

    function isGroupCreator(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    function matchDoc(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId));
    }

    function matchIsOpen(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId)) &&
        request.time < matchDoc(matchId).data.kickoffAt;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isPlatformAdmin());
      allow update: if signedIn() && request.auth.uid == uid &&
        !("roleGlobal" in request.resource.data.diff(resource.data).changedKeys());
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow create: if false;
      allow read: if isMember(groupId) || isPlatformAdmin();
      allow update, delete: if false;

      match /members/{uid} {
        allow read: if isMember(groupId) || isPlatformAdmin();
        allow create: if isGroupAdmin(groupId) || isPlatformAdmin() ||
          (isGroupCreator(groupId) && request.auth.uid == uid && request.resource.data.role == "group_admin") ||
          (signedIn() && request.auth.uid == uid && request.resource.data.role == "participant");
        allow update: if isGroupAdmin(groupId) || isPlatformAdmin();
        allow delete: if isPlatformAdmin();
      }

      match /invites/{code} {
        allow read: if isGroupAdmin(groupId) || isPlatformAdmin();
        allow write: if false;
      }

      match /predictions/{predictionId} {
        // NOTA: la visibilidad por-pronóstico (predictionVisibility) NO se puede
        // enforcear aquí con condiciones por-documento (resource.data.uid, get())
        // porque la app consulta la colección completa sin filtro de uid
        // (listPredictions), y Firestore deniega cualquier query que no pueda
        // satisfacer estáticamente la regla. La visibilidad se filtra en UI
        // (isCellVisible). Reintroducir el enforcement en DB requiere rediseñar
        // las queries (filtrar por uid o denormalizar la visibilidad). Ver incidente 2026-06-09.
        allow read: if isMember(groupId) || isPlatformAdmin();
        allow create, update, delete: if false;
      }

      match /scores/{uid} {
        allow read: if isMember(groupId) || isPlatformAdmin();
        allow write: if false;
      }

      match /prizes/{uid} {
        allow read: if isMember(groupId) || isPlatformAdmin();
        allow write: if false;
      }
    }

    match /groupMembers/{id} {
      // Paréntesis explícitos para evitar ambigüedad de precedencia (&&/||)
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isPlatformAdmin();
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /auditLogs/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /apiSyncLogs/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /systemConfig/{id} {
      // providerStatus y tournament son necesarios para el cliente; el resto solo para admin
      allow read: if (id == "providerStatus" || id == "tournament") && signedIn() || isPlatformAdmin();
      allow write: if false;
    }
  }
}
