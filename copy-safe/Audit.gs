function auditLog(action,sheetName,affectedRecord,details,result){var ss=SpreadsheetApp.getActiveSpreadsheet();var auditSheet=getOrCreateSheet_(ss,Q26.SHEETS.AUDIT);ensureHeader_(auditSheet,Q26.HEADERS[Q26.SHEETS.AUDIT]);auditSheet.appendRow([new Date(),getCurrentUserEmail_(),action||'',sheetName||'',affectedRecord||'',safeStringify_(details||{}),result||'OK']);}function auditError(action,sheetName,affectedRecord,error,details){auditLog(action,sheetName,affectedRecord,{error:error&&error.message?error.message:String(error),details:details||{}},'ERROR');}function getCurrentUserEmail_(){try{var email=Session.getActiveUser().getEmail();return email||'usuario_no_disponible';}catch(err){return'usuario_no_disponible';}}function safeStringify_(value){try{return JSON.stringify(value);}catch(err){return String(value);}}
